# =====================================================================
# KLAIM — environment configuration
# NEVER commit real values. Private keys stay server-side only: they are
# never returned by an API, sent to the frontend, stored in localStorage,
# displayed in the UI or included in MCP configuration.
# =====================================================================

# --------------------------------------------------------------- MCP URL
# Override the public MCP endpoint URL shown in the UI and Claude configuration.
# When absent, KLAIM derives it automatically from the current origin:
#   Local:      http://localhost:8080/api/public/mcp
#   Production: https://your-domain.com/api/public/mcp
VITE_PUBLIC_MCP_URL=

# ---------------------------------------------------------------- x402
# Wallet that RECEIVES verification payments (KLAIM provider side).
PROVIDER_WALLET_ADDRESS=

# GoPlausible facilitator (verify + settle on Algorand).
FACILITATOR_URL=https://facilitator.goplausible.xyz

# CAIP-2 network id for Algorand Testnet (full genesis hash as required by GoPlausible).
NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=

# Testnet USDC asset id (ASA 10458941).
USDC_ASSET_ID=10458941

# Price per verification, in USDC.
VERIFICATION_PRICE=0.01

# ------------------------------------------------- test client (payer only)
# Used ONLY by scripts/test-x402.ts and tests/. Never read by the app server.
PAYER_WALLET_ADDRESS=
PAYER_PRIVATE_KEY=          # 25-word Algorand mnemonic — local dev only

# KLAIM agent credentials issued in the Verifier console (Agents → Provision key).
KLAIM_AGENT_ID=
KLAIM_AGENT_KEY=
KLAIM_BASE_URL=http://localhost:8080
KLAIM_DEMO_DID=did:identipi:demo-user-001

# ------------------------------------------- Strands provider agent (optional)
STRANDS_MODEL_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ------------------------------------------------------- DigiLocker (pending)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=

# ------------------------------------------------------------ Midnight ZK
# When set, zkpService delegates to the standalone klaim-zkp service (real
# Compact circuits). Absent → local proof adapter (engine=local).
MIDNIGHT_PROVER_URL=

# ------------------------------------------- internal service-to-service auth
# Shared token for backend-to-backend calls (settle + zkp). Injected from
# Secret Manager in production — never commit the real value.
INTERNAL_SERVICE_TOKEN=

# =====================================================================
# Funding a Testnet wallet
#   1. Create an account: `bunx algosdk` or Pera Wallet (Testnet mode).
#   2. Fund ALGO: https://bank.testnet.algorand.network/
#   3. Opt in to USDC ASA 10458941 with that account.
#   4. Get Testnet USDC: https://faucet.circle.com/ (select Algorand Testnet).
#   5. Verify balances on https://lora.algokit.io/testnet
# =====================================================================
