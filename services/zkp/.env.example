# KLAIM ZKP service — environment (no secrets committed)
#
# Shared internal token used by the KLAIM protocol service to authenticate
# server-to-server calls to this ZK service. Same value both sides must hold.
# In production this is injected from Secret Manager, not committed.
INTERNAL_SERVICE_TOKEN=

# Port the service listens on (Cloud Run injects PORT=8080).
PORT=6400
