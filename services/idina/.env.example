# services/idina — environment reference. Never commit real credentials.

# Cloud Run injects PORT; default 8082 locally. Service listens on 0.0.0.0:$PORT.
PORT=8082

# Orchestration mode:
#   agent         — Google ADK-equivalent (Gemini/Vertex function-calling)
#   deterministic — fixed orchestration over the same 3 harnesses (default)
IDINA_MODE=deterministic

# --- Gemini / Vertex AI (only used when IDINA_MODE=agent) ---
# Prefer Vertex AI with Cloud Run service identity (no API key baked in).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.0-flash
# (Alternative for local dev only: GOOGLE_API_KEY — do NOT use in production.)

# --- Service clients (server-to-server; never hardcode URLs) ---
KLAIM_API_URL=            # system of record; Idina reads consent from here
PROTOCOL_SERVICE_URL=     # x402 + Algorand settlement (payment harness)
ZKP_SERVICE_URL=          # proof generation (zkp harness)
INTERNAL_SERVICE_TOKEN=   # shared internal auth (set out-of-band / Secret Manager)
