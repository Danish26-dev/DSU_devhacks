{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@klaim/types": ["../../packages/types/src/index.ts"],
      "@klaim/contracts": ["../../packages/contracts/src/index.ts"],
      "@klaim/utils": ["../../packages/utils/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
