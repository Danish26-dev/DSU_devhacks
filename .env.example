# =====================================================================
# KLAIM V2 — environment reference
#
# Only variables actually consumed by the CURRENT V2 code are listed here.
# Protocol/x402, Algorand, ZKP, Idina/Vertex and deployment variables will be
# added as those services are implemented in later phases. Never commit real
# secrets.
# =====================================================================

# ---------------------------------------------------------- backend/klaim-api
# Port the KLAIM API listens on (Cloud Run injects this). Default: 8080.
PORT=8080

# Comma-separated CORS allowlist of frontend origins (empty = none).
# e.g. http://localhost:5173,http://localhost:5174
ALLOWED_ORIGINS=

# Development/test only. When "true", mounts the mock lifecycle trigger
# endpoints (POST /api/dev/verification-requests/:id/{settle,verify}) that
# exercise the mock payment + verification adapters. MUST be unset/false in
# production.
KLAIM_DEV_ADAPTERS=
