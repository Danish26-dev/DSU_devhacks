# backend/klaim-api — environment reference. Never commit real secrets.

# Port the API listens on (Cloud Run / container injects this). Default 8080.
PORT=8080

# CORS allowlist — comma-separated frontend origins. Empty = no CORS headers
# (same-origin / non-browser only). Never use "*" in production.
# e.g. https://quickdrop-atnwarjo4q-el.a.run.app,https://klaim.example.app
ALLOWED_ORIGINS=

# Protocol service (x402 + Algorand settlement). When BOTH are set, the API uses
# the real ProtocolPaymentAdapter; otherwise it falls back to the mock adapter.
# See docs/PAYMENT_ADAPTER_CONTRACT.md.
PROTOCOL_SERVICE_URL=
INTERNAL_SERVICE_TOKEN=            # shared secret with the protocol service (set out-of-band)

# DEV/TEST ONLY. When "true", mounts the mock settle/verify trigger endpoints.
# MUST be unset / "false" in production.
KLAIM_DEV_ADAPTERS=
